<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LevelZeroCheck</RootNamespace>
    <AssemblyName>l0check</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>2.0.0</Version>
    <Authors>HF.Labs</Authors>
    <Company>HF Laboratories</Company>
    <Description>Hardware topology diagnostics and kernel test harness CLI for Intel Level Zero.</Description>
    <RepositoryUrl>https://github.com/hf-laboratories/l0check</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LevelZero.NET" Version="2.0.0" />
  </ItemGroup>
</Project>
